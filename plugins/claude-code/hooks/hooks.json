{
  "description": "Chemical X: route raw runners, git diff/log, source reads and native file tools through chemx; honour chemx file locks; check edited files; session status card.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Agent|Workflow",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/chemx-launch.mjs\" hook claude-pre-tool", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/chemx-launch.mjs\" hook claude-post-edit", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/chemx-launch.mjs\" hook session-start", "timeout": 10 }
        ]
      }
    ]
  }
}
