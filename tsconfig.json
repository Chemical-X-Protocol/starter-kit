{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/ui/*", "src/*"]
    }
  },
  "include": ["blueprints", "hooks", "src"],
  "exclude": ["blueprints/_vitest.config.vue.ts", "blueprints/_vitest.config.svelte.ts"]
}
