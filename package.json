{
  "name": "@chemx/starter-kit",
  "version": "26.9.25-861",
  "description": "Chemical X Protocol: Private drop-in architecture starter kit and capsule generator",
  "type": "module",
  "bin": {
    "create-chemx": "cli/create.js",
    "chemx": "cli/index.js",
    "chem-x": "cli/index.js",
    "chemical-x": "cli/index.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chemical-X-Protocol/starter-kit.git"
  },
  "homepage": "https://chemicalx.xophz.com",
  "bugs": {
    "url": "https://github.com/Chemical-X-Protocol/starter-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "cli",
    "blueprints",
    "scripts",
    "README.md",
    "LICENSE",
    "docs",
    "assets"
  ],
  "exports": {
    ".": "./cli/index.js",
    "./audit": "./cli/audit.js",
    "./build": "./cli/build.js",
    "./search": "./cli/search.js",
    "./mcp": "./cli/mcp/index.js",
    "./reader": "./cli/reader.js",
    "./patcher": "./cli/patcher.js",
    "./errors": "./cli/errors/index.js"
  },
  "scripts": {
    "chemx": "node cli/index.js",
    "bench": "node benchmarks/run-benchmark.mjs",
    "ui": "node cli/index.js ui",
    "dev:ui": "node cli/index.js ui --dev",
    "dev:ui:watch": "node --watch --watch-path=cli cli/index.js ui --dev",
    "test": "node --test cli/audit/*.spec.js cli/mcp/*.spec.js cli/build/*.spec.js cli/team/*.spec.js cli/errors/*.spec.js cli/*.spec.js",
    "check:frameworks": "node scripts/check-framework-generation.mjs",
    "prepublishOnly": "node scripts/check-framework-generation.mjs",
    "typecheck": "tsc --noEmit",
    "publish:both": "node scripts/publish-both.mjs",
    "postinstall": "node cli/postinstall.js",
    "chemx:mcp": "chemx mcp",
    "chemx:verify": "chemx verify",
    "chemx:test": "chemx test",
    "chemx:typecheck": "chemx typecheck"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "chemx": "26.9.20-408",
    "typescript": "^5.9.3"
  }
}
