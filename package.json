{
  "name": "create-chemx",
  "version": "26.9.16-21",
  "description": "Chemical X Protocol: Private drop-in architecture starter kit and capsule generator",
  "type": "module",
  "bin": {
    "create-chemx": "cli/index.js",
    "chemx": "cli/index.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chemical-X-Protocol/starter-kit.git"
  },
  "homepage": "https://chemicalx.xophz.com",
  "bugs": {
    "url": "https://github.com/Chemical-X-Protocol/starter-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "cli",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": "./cli/index.js",
    "./audit": "./cli/audit.js",
    "./build": "./cli/build.js",
    "./search": "./cli/search.js",
    "./mcp": "./cli/mcp/index.js",
    "./reader": "./cli/reader.js",
    "./patcher": "./cli/patcher.js"
  },
  "scripts": {
    "publish:both": "node scripts/publish-both.mjs",
    "test": "node --test cli/audit/*.spec.js cli/mcp/*.spec.js cli/*.spec.js",
    "typecheck": "tsc --noEmit",
    "create-capsule": "node cli/index.js",
    "audit": "node cli/index.js audit",
    "ci:audit": "node cli/index.js audit --ci --dir=cli",
    "chemx": "node cli/index.js",
    "q": "node cli/index.js q",
    "search": "node cli/index.js search",
    "mcp": "node cli/index.js mcp",
    "install-mcp": "node cli/index.js install-mcp",
    "postinstall": "node scripts/postinstall.mjs",
    "read": "node cli/index.js read",
    "patch": "node cli/index.js patch"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3"
  }
}
