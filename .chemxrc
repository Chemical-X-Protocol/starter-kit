{
  "profile": "atomic-strict",
  "scope": ".",
  "commit": {
    "skipCi": false,
    "coAuthor": "x@hallofthegods.com"
  },
  "rules": {
    "component-max-complexity": 12,
    "max-hook-density": 4,
    "max-render-depth": 4,
    "max-prop-count": 7,
    "prefer-design-tokens": "warning",
    "enforce-file-length": false,
    "rule-of-three-abstractions": true,
    "ai-slop-detection": "critical"
  },
  "nativeFileTools": "block",
  "guardNudges": "block"
}
